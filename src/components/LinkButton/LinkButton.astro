---
import Icon from '@/components/Icon';

interface Props {
  href: string;
  variant?: 'primary' | 'text';
  direction?: 'down' | 'up' | 'diagonal';
}
const { href, variant = 'primary', direction = 'diagonal' } = Astro.props;
---
<a href={href} class:list={['link-button', variant]}>
  <span><slot /></span>
  <span class="button-arrow"><Icon name={direction} size={18} /></span>
</a>

<style>
  .link-button { display: inline-flex; align-items: center; justify-content: center; gap: 24px; min-height: 48px; font-size: 16px; line-height: 24px; font-weight: 600; transition: background-color 400ms var(--ease-bruma), transform 400ms var(--ease-bruma); }
  .primary { background: var(--color-terracotta); color: var(--color-paper); padding: 12px 16px 12px 24px; border-radius: 999px; }
  .button-arrow { display: flex; justify-content: center; align-items: center; width: 32px; height: 32px; flex: none; border-radius: 50%; }
  .primary .button-arrow { background: var(--color-paper); color: var(--color-terracotta); }
  .primary:hover { background: #8d3b28; transform: translateY(-2px); }
  .text { gap: 12px; color: var(--color-terracotta); padding-block: 8px; }
  .text .button-arrow { border: 1px solid #a64b354d; transition: transform 400ms var(--ease-bruma); }
  .text:hover .button-arrow { transform: translate(2px, -2px); }
  .link-button:active { transform: scale(.98); }
</style>
