---
import { Picture } from 'astro:assets';
import type { MenuItem } from './Menu.types';
interface Props { item: MenuItem; index: number; }
const { item, index } = Astro.props;
---
<article class="menu-card" data-reveal>
  <div class="product-image">
    <Picture src={item.image} alt={item.alt} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[360, 720, 1200]} sizes="(min-width: 1440px) 400px, (min-width: 768px) 30vw, 100vw" width={720} quality={80} loading="lazy" />
    <span class="product-number" aria-hidden="true">0{index + 1}</span>
  </div>
  <div class="product-meta"><h3>{item.name}</h3><span>{item.category}</span></div>
  <p>{item.description}</p>
</article>

<style>
  .product-image { position: relative; border-radius: 12px; overflow: hidden; background: var(--color-cream); }
  .product-image :global(picture) { display: block; }
  .product-image :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; transition: transform 700ms var(--ease-bruma); }
  .menu-card:hover .product-image :global(img) { transform: scale(1.025); }
  .product-number { position: absolute; left: 16px; top: 16px; display: grid; place-items: center; width: 32px; height: 32px; background: var(--color-paper); border-radius: 50%; font-size: 12px; color: var(--muted); }
  .product-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 24px; }
  h3 { font-family: var(--font-display); font-weight: 400; font-size: 24px; line-height: 32px; letter-spacing: -.04em; }
  .product-meta > span { color: var(--color-terracotta); font-size: 12px; line-height: 16px; }
  .menu-card p { font-size: 16px; line-height: 24px; color: var(--muted); margin-top: 12px; max-width: 352px; }
  @media(min-width: 768px) and (max-width: 1023px) { .product-meta { align-items: flex-start; flex-direction: column; gap: 4px; } }
</style>
