---
import ArrowDown from '@/assets/icons/arrow-down.svg';
import ArrowUp from '@/assets/icons/arrow-up.svg';
import ArrowUpRight from '@/assets/icons/arrow-up-right.svg';
import CoffeeBean from '@/assets/icons/coffee-bean.svg';

interface Props {
  name: 'down' | 'up' | 'diagonal' | 'bean';
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
const icons = { down: ArrowDown, up: ArrowUp, diagonal: ArrowUpRight, bean: CoffeeBean };
const Svg = icons[name];
---
<Svg width={size} height={size} fill="currentColor" class={className} aria-hidden="true" focusable="false" />
