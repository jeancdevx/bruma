---
import ResponsiveImage from '@/components/ResponsiveImage';
import SceneCopy from './SceneCopy.astro';
import Icon from '@/components/Icon';
import type { StoryScene } from './ScrollStory.types';

interface Props { scenes: readonly StoryScene[]; }
const { scenes } = Astro.props;
---
<section id="recorrido" class="scroll-story" aria-label="El mundo de Bruma" data-story data-story-active="0">
  <div class="container story-shell">
    <div class="story-stage" data-story-stage>
      <div class="story-stamp" aria-hidden="true">
        <svg class="stamp-lettering" viewBox="0 0 112 112"><defs><path id="stamp-ring" d="M56,18 a38,38 0 1,1 -0.1,0" /></defs><text fill="currentColor" font-size="12"><textPath href="#stamp-ring" textLength="238">CAFÉ &amp; CALMA · HECHO CON CARIÑO · </textPath></text></svg>
        <span class="stamp-bean"><Icon name="bean" size={24} /></span>
      </div>
      <div class="visual-frames" data-story-frames role="img" aria-label={scenes[0].alt}></div>
      <div class="stage-footer">
        <span class="stage-caption">Un pequeño mundo para ti</span>
        <ol class="stage-route" aria-label="Momentos del recorrido">
          {scenes.map((scene, index) => <li><a href={`#${scene.id}`} aria-label={`${scene.number}: ${scene.label}`} aria-current={index === 0 ? 'step' : undefined} data-route-index={index}>{scene.number}</a></li>)}
        </ol>
      </div>
      <div class="stage-progress" aria-hidden="true"><span data-stage-progress></span></div>
    </div>
    <div class="story-steps">
      {scenes.map((scene, index) => (
        <section id={scene.id} class="story-step" data-story-step data-scene-label={scene.alt} aria-labelledby={`${scene.id}-title`} tabindex="-1">
          <SceneCopy scene={scene} first={index === 0} />
          <figure class="scene-original" data-scene-image>
            <ResponsiveImage image={scene.image} alt={scene.alt} sizes="(min-width: 1376px) 730px, (min-width: 1024px) calc(57vw - 54.72px), (min-width: 768px) calc(85vw - 81.6px), calc(100vw - 48px)" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
            <figcaption>{scene.number} <span></span> {scene.label}</figcaption>
          </figure>
        </section>
      ))}
    </div>
  </div>
</section>

<script>
  import { mountScrollStory } from './ScrollStory.client';
  document.querySelectorAll<HTMLElement>('[data-story]').forEach(mountScrollStory);
</script>

<style>
  .story-stage { display: none; }
  .story-step { display: grid; align-items: center; border-bottom: 1px solid var(--line); padding-bottom: 32px; }
  .story-step:last-child { border-bottom: none; }
  .scene-original { align-self: center; }
  .scene-original :global(img) { width: 100%; height: auto; mix-blend-mode: darken; border-radius: 8px; }
  .scene-original figcaption { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 12px; font-size: 12px; line-height: 16px; color: var(--muted); }
  .scene-original figcaption span { width: 32px; height: 1px; background: var(--line); }
  @media(min-width: 768px) and (max-width: 1023px) { .scene-original { width: 85%; justify-self: center; } }
  @media(min-width: 1024px) {
    .story-step { grid-template-columns: 43% 57%; min-height: calc(100svh - var(--header-height)); border-bottom: none; padding-bottom: 0; }
    .scroll-story[data-enhanced] .story-shell { display: grid; grid-template-columns: 43% 57%; }
    .scroll-story[data-enhanced] .story-steps { grid-column: 1; grid-row: 1; }
    .scroll-story[data-enhanced] .story-step { display: flex; min-height: calc(100svh - var(--header-height)); }
    .scroll-story[data-enhanced] .scene-original:not(.visual-frame) { display: none; }
    .scroll-story[data-enhanced] .story-stage { display: flex; flex-direction: column; grid-column: 2; grid-row: 1; align-self: start; position: sticky; top: var(--header-height); height: calc(100svh - var(--header-height)); min-height: 480px; }
    .visual-frames { flex: 1; position: relative; min-height: 0; }
    .visual-frames :global(.visual-frame) { position: absolute; inset: 0; display: flex; align-items: center; opacity: 0; will-change: transform, opacity; }
    .visual-frames :global(img) { width: 100%; height: auto; border-radius: 8px; mix-blend-mode: darken; }
    .visual-frames :global(figcaption) { display: none; }
    .story-stamp { position: absolute; z-index: 2; right: 0; top: 32px; width: 112px; height: 112px; border: 1px solid #a64b3559; border-radius: 50%; transform: rotate(12deg); color: var(--color-terracotta); background: var(--color-cream); }
    .stamp-lettering { width: 100%; height: 100%; }
    .stamp-bean { position: absolute; left: 44px; top: 44px; }
    .stage-footer { display: flex; align-items: center; justify-content: space-between; padding: 24px 0 24px 24px; }
    .stage-caption { font-size: 12px; color: var(--muted); }
    .stage-route { list-style: none; display: flex; gap: 8px; margin: 0; padding: 0; }
    .stage-route a { display: grid; place-items: center; min-width: 44px; min-height: 44px; font-size: 12px; border: 1px solid transparent; border-radius: 50%; transition: background-color 400ms var(--ease-bruma), color 400ms var(--ease-bruma); }
    .stage-route a[aria-current] { color: var(--color-terracotta); border-color: #a64b3559; }
    .stage-route a:hover { background: var(--color-paper); }
    .stage-progress { height: 1px; background: var(--line); margin-left: 24px; }
    .stage-progress span { display: block; width: 100%; height: 1px; background: var(--color-terracotta); transform: scaleX(.3333); transform-origin: left; }
  }
  @media(prefers-reduced-motion: reduce) { .story-stamp { transform: none; } }
</style>
