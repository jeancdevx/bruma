---
import Icon from '@/components/Icon';
interface Props { lines: readonly string[]; body: string; }
const { lines, body } = Astro.props;
---
<section class="manifesto" aria-labelledby="manifesto-title" data-manifesto>
  <div class="container">
    <div class="manifesto-mark" aria-hidden="true"><span></span><Icon name="bean" size={32} /><span></span></div>
    <h2 id="manifesto-title" aria-label={lines.join(' ')}>
      {lines.map(line => <span class="manifesto-line" aria-hidden="true">{line.split(' ').slice(0, -2).map(word => <span data-word>{word}{' '}</span>)}<span class="word-pair">{line.split(' ').slice(-2).map(word => <span data-word>{word}{' '}</span>)}</span></span>)}
    </h2>
    <p>{body}</p>
  </div>
</section>

<script>
  import { mountManifesto } from './Manifesto.client';
  document.querySelectorAll<HTMLElement>('[data-manifesto]').forEach(mountManifesto);
</script>

<style>
  .manifesto { padding-block: 96px; text-align: center; }
  .manifesto-mark { display: flex; align-items: center; justify-content: center; gap: 24px; margin-bottom: 32px; color: var(--color-terracotta); }
  .manifesto-mark > span { width: 48px; height: 1px; background: #a64b354d; }
  h2 { font-family: var(--font-display); font-weight: 400; font-size: 36px; line-height: 40px; letter-spacing: -.05em; }
  .manifesto-line { display: block; }
  .word-pair { display: inline-block; white-space: nowrap; }
  [data-word] { transition: color 700ms var(--ease-bruma); }
  [data-word-reveal] [data-word] { color: #2b1b144d; }
  [data-word-reveal] [data-word][data-read] { color: var(--color-espresso); }
  p { margin-top: 32px; color: var(--muted); font-size: 14px; line-height: 20px; }
  @media(min-width: 768px) { h2 { font-size: 60px; line-height: 60px; } }
  @media(prefers-reduced-motion: reduce) { [data-word-reveal] [data-word] { color: var(--color-espresso); } }
</style>
