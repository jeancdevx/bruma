---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LinkButton from '@/components/LinkButton';
import { Picture } from 'astro:assets';
import { scenes } from '@/data/cafe';
---
<BaseLayout title="Bruma Café · Este camino no lleva a una taza">
  <main id="contenido" class="container not-found" tabindex="-1">
    <div><p class="eyebrow">404 · Una pequeña vuelta</p><h1>Este camino no lleva a una taza.</h1><p class="body-copy">Pero tu próxima pausa sigue esperándote en Bruma.</p><LinkButton href="/">Volver a Bruma</LinkButton></div>
    <Picture src={scenes[0].image} alt={scenes[0].alt} formats={['avif', 'webp']} fallbackFormat="jpg" width={720} quality={80} />
  </main>
</BaseLayout>
<style>
  .not-found { display: grid; gap: 32px; align-items: center; min-height: 100svh; padding-block: 64px; }
  .eyebrow { color: var(--color-terracotta); margin-bottom: 24px; }
  h1 { font-family: var(--font-display); font-weight: 400; font-size: 36px; line-height: 40px; letter-spacing: -.05em; margin-bottom: 24px; }
  .body-copy { margin-bottom: 32px; }
  .not-found :global(img) { mix-blend-mode: darken; }
  @media(min-width: 768px) { .not-found { grid-template-columns: 1fr 1fr; } h1 { font-size: 60px; line-height: 60px; } }
</style>
